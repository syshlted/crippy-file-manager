<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions of its own. The file manager reaches the vault through encri's companion service
      (encri D112, D120), which needs none, and the client library merges the one `<queries>` entry
      that lets this app see encri from API 30 (encri-api L12).

      allowBackup is false for encri's reason (encri D8): nothing this app keeps should leave the
      phone through a backup transport the user never chose. Today it keeps nothing.

      enableOnBackInvokedCallback, so back reaches FilesActivity's callback from API 33 on every ROM,
      rather than only where API 36 turns it on for an app that targets it. Ignored below 33.
    -->
    <application
        android:name=".FilesApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".FilesActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
    </application>
</manifest>
